{
  "$schema": "node_modules/wrangler/config-schema.json",
  "services": [{ "binding": "FEEDBACK_INBOX", "service": "mcp-client-bio", "entrypoint": "FeedbackInbox" }],
  "vars": { "MCP_FEEDBACK_SOURCE": "klifs" },
  "name": "klifs-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "ai": "./src/ai-stub.ts" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KlifsDataDO"] }],
  "durable_objects": {
    "bindings": [{ "name": "KLIFS_DATA_DO", "class_name": "KlifsDataDO" }]
  },
  "worker_loaders": [{ "binding": "CODE_MODE_LOADER" }],
  "observability": { "enabled": true },
  "dev": { "port": 8908 }
}
